{
  "name": "@hushmark/gateway",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": "22.x"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --dts --clean",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/unit test/streaming",
    "test:e2e": "vitest run test/e2e test/invariants"
  },
  "dependencies": {
    "@hushmark/shared": "workspace:*",
    "fastify": "^5.8.0",
    "undici": "^7.16.0",
    "yaml": "^2.8.1",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "fast-check": "^4.3.0",
    "tsup": "^8.5.1",
    "vitest": "^4.0.18"
  }
}
