{
  "name": "@hushmark/shared",
  "version": "0.1.1",
  "description": "Shared public schemas and taxonomy types for Hushmark integrations",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "engines": {
    "node": "22.x"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lokomotifai/hushmark-open-core.git",
    "directory": "packages/shared"
  },
  "homepage": "https://github.com/lokomotifai/hushmark-open-core#readme",
  "bugs": {
    "url": "https://github.com/lokomotifai/hushmark-open-core/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "vitest": "^4.0.18"
  }
}
