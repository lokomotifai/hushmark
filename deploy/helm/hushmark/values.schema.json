{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["core", "gateway", "console", "enterprise", "postgres", "networkPolicy"],
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "imagePullSecrets": { "type": "array", "items": { "type": "object" } },
    "core": { "$ref": "#/$defs/workloadCore" },
    "gateway": { "$ref": "#/$defs/workloadGateway" },
    "console": { "$ref": "#/$defs/workloadConsole" },
    "enterprise": { "$ref": "#/$defs/enterprise" },
    "postgres": { "$ref": "#/$defs/postgres" },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": { "enabled": { "type": "boolean" } }
    }
  },
  "$defs": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "digest": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "resources": { "type": "object" },
    "service": {
      "type": "object",
      "required": ["port"],
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "workloadCore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replicaCount", "image", "model", "service", "resources", "nerBackend", "nerThreshold"],
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 1 },
        "image": { "$ref": "#/$defs/image" },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["baked", "existingClaim"],
          "properties": { "baked": { "type": "boolean" }, "existingClaim": { "type": "string" } }
        },
        "service": { "$ref": "#/$defs/service" },
        "resources": { "$ref": "#/$defs/resources" },
        "nerBackend": { "enum": ["disabled", "torch", "onnx"] },
        "nerThreshold": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "workloadGateway": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replicaCount", "image", "service", "existingSecret", "apiKeyKey", "openaiApiKeyKey", "anthropicApiKeyKey", "openaiUpstream", "anthropicUpstream", "resources"],
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 1 },
        "image": { "$ref": "#/$defs/image" },
        "service": { "$ref": "#/$defs/service" },
        "existingSecret": { "type": "string", "minLength": 1 },
        "apiKeyKey": { "type": "string", "minLength": 1 },
        "openaiApiKeyKey": { "type": "string", "minLength": 1 },
        "anthropicApiKeyKey": { "type": "string", "minLength": 1 },
        "openaiUpstream": { "type": "string", "format": "uri" },
        "anthropicUpstream": { "type": "string", "format": "uri" },
        "resources": { "$ref": "#/$defs/resources" }
      }
    },
    "workloadConsole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "replicaCount", "image", "service", "resources"],
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 1 },
        "image": { "$ref": "#/$defs/image" },
        "service": { "$ref": "#/$defs/service" },
        "resources": { "$ref": "#/$defs/resources" }
      }
    },
    "enterprise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "licenseSecret", "licenseKey", "publicKeyKey", "databaseSecret", "databaseUrlKey", "adminEmail", "adminSecret", "adminPasswordKey", "kms"],
      "properties": {
        "enabled": { "type": "boolean" },
        "licenseSecret": { "type": "string" },
        "licenseKey": { "type": "string" },
        "publicKeyKey": { "type": "string" },
        "databaseSecret": { "type": "string" },
        "databaseUrlKey": { "type": "string" },
        "adminEmail": { "type": "string" },
        "adminSecret": { "type": "string" },
        "adminPasswordKey": { "type": "string" },
        "kms": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "keyId", "secret", "tokenKey", "vaultAddress", "vaultTransitMount"],
          "properties": {
            "kind": { "enum": ["vault", "azure", "gcp"] },
            "keyId": { "type": "string" },
            "secret": { "type": "string" },
            "tokenKey": { "type": "string" },
            "vaultAddress": { "type": "string" },
            "vaultTransitMount": { "type": "string" }
          }
        }
      }
    },
    "postgres": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "image", "existingSecret", "passwordKey", "database", "username", "persistence", "resources"],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "$ref": "#/$defs/image" },
        "existingSecret": { "type": "string" },
        "passwordKey": { "type": "string" },
        "database": { "type": "string" },
        "username": { "type": "string" },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "size", "storageClass"],
          "properties": {
            "enabled": { "type": "boolean" },
            "size": { "type": "string" },
            "storageClass": { "type": "string" }
          }
        },
        "resources": { "$ref": "#/$defs/resources" }
      }
    }
  }
}
