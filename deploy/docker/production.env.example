# Public, non-secret deployment settings. Copy to /etc/hushmark/production.env
# and keep the real file outside the repository with mode 0600.
HUSHMARK_DOMAIN=hushmark.example.com
HUSHMARK_MODEL_DIR=/srv/hushmark/models
HUSHMARK_SECRETS_DIR=/etc/hushmark/secrets
HUSHMARK_OPENAI_UPSTREAM=https://api.openai.com/v1
HUSHMARK_ANTHROPIC_UPSTREAM=https://api.anthropic.com/v1
HUSHMARK_VAULT_MAX_ENTRIES=100000
HUSHMARK_VAULT_TTL_SEC=86400
HUSHMARK_UNMASK_LIMIT=100
HUSHMARK_TRUST_PROXY_HOPS=1
HUSHMARK_RATE_LIMIT_MAX=120
HUSHMARK_RATE_LIMIT_WINDOW_SEC=60
HUSHMARK_BODY_LIMIT_BYTES=1048576
HUSHMARK_CORE_BODY_LIMIT_BYTES=1048576
HUSHMARK_CORE_MAX_CONCURRENCY=4
HUSHMARK_CORE_QUEUE_TIMEOUT_MS=250

# Optional local validation overrides. Do not set these on the public host.
# HUSHMARK_HTTP_PORT=18080
# HUSHMARK_HTTPS_PORT=18443
